{
  "expo": {
    "name": "AniMed",
    "slug": "animed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/animed_logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/animed_logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.animed.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/animed_logo.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/animed_logo.jpg"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
